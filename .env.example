# Copy this file to .env and fill in your own real values.
# Never commit the actual .env file — it's already in .gitignore.

# Google Gemini API key — get one free at https://aistudio.google.com
GOOGLE_API_KEY=your-gemini-api-key-here

# AWS credentials for DynamoDB access (IAM user with DynamoDB permissions)
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_REGION=ap-south-1
